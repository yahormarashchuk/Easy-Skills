{
  "name": "easy-skills",
  "version": "0.1.0-alpha.1",
  "description": "Local, recoverable engineering workflows for Codex CLI and Claude Code",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yahormarashchuk/Easy-Skills.git"
  },
  "homepage": "https://github.com/yahormarashchuk/Easy-Skills#readme",
  "bugs": { "url": "https://github.com/yahormarashchuk/Easy-Skills/issues" },
  "bin": {
    "easy-skills": "dist/cli/index.js"
  },
  "exports": "./dist/index.js",
  "files": [
    "dist",
    "skills",
    "schemas",
    "templates",
    "docs",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "third-party"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc && node scripts/schemas.mjs && node scripts/package-skills.mjs",
    "check": "tsc --noEmit",
    "test": "node scripts/test.mjs",
    "dev": "tsx src/cli/index.ts",
    "prepack": "npm run build",
    "smoke:clients": "tsx scripts/smoke-clients.ts"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "nodemailer": "^10.1.7",
    "which": "^7.0.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/which": "^3.0.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
