{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "outcome": {
      "type": "string",
      "enum": [
        "passed",
        "blocked",
        "failed"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "anyOf": [
            {
              "type": "number",
              "const": 1
            },
            {
              "type": "number",
              "const": 2
            }
          ]
        },
        "featureId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "spec": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "object",
          "properties": {
            "schemaVersion": {
              "anyOf": [
                {
                  "type": "number",
                  "const": 1
                },
                {
                  "type": "number",
                  "const": 2
                }
              ]
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "repository": {
              "type": "string",
              "pattern": "^[\\w.-]+\\/[\\w.-]+$"
            },
            "mainBranch": {
              "type": "string",
              "minLength": 1
            },
            "remote": {
              "default": "origin",
              "type": "string",
              "const": "origin"
            },
            "githubTransport": {
              "type": "string",
              "const": "gh"
            },
            "checks": {
              "minItems": 1,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "timeoutMs": {
                    "default": 300000,
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 3600000
                  },
                  "resource": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "command",
                  "args",
                  "timeoutMs"
                ],
                "additionalProperties": false
              }
            },
            "mergePolicy": {
              "type": "object",
              "properties": {
                "mode": {
                  "type": "string",
                  "enum": [
                    "strict",
                    "queue"
                  ]
                },
                "requiredChecks": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "appId": {
                        "type": "integer",
                        "exclusiveMinimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "name"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "mode",
                "requiredChecks"
              ],
              "additionalProperties": false
            },
            "setup": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                  },
                  "command": {
                    "type": "string",
                    "minLength": 1
                  },
                  "args": {
                    "default": [],
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "timeoutMs": {
                    "default": 300000,
                    "type": "integer",
                    "minimum": 100,
                    "maximum": 3600000
                  },
                  "resource": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "command",
                  "args",
                  "timeoutMs"
                ],
                "additionalProperties": false
              }
            },
            "protectedInputs": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "required": [
            "schemaVersion",
            "name",
            "repository",
            "mainBranch",
            "remote",
            "githubTransport",
            "checks"
          ],
          "additionalProperties": false
        },
        "assignments": {
          "type": "object",
          "properties": {
            "DEFINE": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "codex",
                    "claude-code"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
                },
                "effort": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              },
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false
            },
            "PLAN": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "codex",
                    "claude-code"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
                },
                "effort": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              },
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false
            },
            "BUILD": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "codex",
                    "claude-code"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
                },
                "effort": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              },
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false
            },
            "VERIFY": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "codex",
                    "claude-code"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
                },
                "effort": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              },
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false
            },
            "REVIEW": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "codex",
                    "claude-code"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
                },
                "effort": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              },
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false
            },
            "SHIP": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": [
                    "codex",
                    "claude-code"
                  ]
                },
                "model": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 150,
                  "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
                },
                "effort": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_-]{0,31}$"
                }
              },
              "required": [
                "provider",
                "model"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "DEFINE",
            "PLAN",
            "BUILD",
            "VERIFY",
            "REVIEW",
            "SHIP"
          ],
          "additionalProperties": false
        },
        "tasks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "dependsOn": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                }
              },
              "acceptance": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "scope": {
                "type": "object",
                "properties": {
                  "areas": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                    }
                  },
                  "paths": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "areas",
                  "paths"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "id",
              "title",
              "description",
              "dependsOn",
              "acceptance"
            ],
            "additionalProperties": false
          }
        },
        "rulesHash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "rulesAgreement": {
          "type": "object",
          "properties": {
            "version": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "hash": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            }
          },
          "required": [
            "version",
            "hash"
          ],
          "additionalProperties": false
        },
        "runnerVersion": {
          "type": "string",
          "enum": [
            "0.1.0-alpha.1",
            "0.1.0-alpha.2"
          ]
        },
        "skillsVersion": {
          "type": "string",
          "enum": [
            "0.1.0-alpha.1",
            "0.1.0-alpha.2"
          ]
        },
        "repairPolicy": {
          "type": "object",
          "properties": {
            "maxCompletedAttempts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100
            }
          },
          "required": [
            "maxCompletedAttempts"
          ],
          "additionalProperties": false
        },
        "protectedInputs": {
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "permissions": {
          "type": "object",
          "properties": {
            "publishIssues": {
              "type": "boolean"
            },
            "mergeIntermediate": {
              "type": "boolean"
            }
          },
          "required": [
            "publishIssues",
            "mergeIntermediate"
          ],
          "additionalProperties": false
        },
        "verification": {
          "type": "object",
          "properties": {
            "diagnostics": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              }
            },
            "browserTools": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^mcp__[\\w-]+__[\\w-]+$"
              }
            }
          },
          "required": [
            "diagnostics",
            "browserTools"
          ],
          "additionalProperties": false
        },
        "workflow": {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "const": "direct"
            },
            "issue": {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "baseHead": {
              "type": "string",
              "pattern": "^[a-f0-9]{40,64}$"
            },
            "permissions": {
              "type": "object",
              "properties": {
                "pushBranch": {
                  "type": "boolean"
                },
                "createPullRequest": {
                  "type": "boolean"
                },
                "closeIssueOnMerge": {
                  "type": "boolean"
                }
              },
              "required": [
                "pushBranch",
                "createPullRequest",
                "closeIssueOnMerge"
              ],
              "additionalProperties": false
            },
            "context": {
              "type": "object",
              "propertyNames": {
                "type": "string",
                "pattern": "^\\.easy-skills\\/(?:rules\\/[^:]+|context\\/[^:]+|project\\.yaml|decisions\\/onboarding\\.json)$"
              },
              "additionalProperties": {
                "type": "string"
              }
            }
          },
          "required": [
            "mode",
            "baseHead",
            "permissions",
            "context"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "schemaVersion",
        "featureId",
        "title",
        "spec",
        "project",
        "assignments",
        "tasks",
        "rulesHash",
        "runnerVersion",
        "skillsVersion",
        "permissions"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "outcome",
    "summary",
    "findings"
  ],
  "additionalProperties": false
}
