{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "featureId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "spec": {
      "type": "string",
      "minLength": 1
    },
    "project": {
      "type": "object",
      "properties": {
        "schemaVersion": {
          "type": "number",
          "const": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "repository": {
          "type": "string",
          "pattern": "^[\\w.-]+\\/[\\w.-]+$"
        },
        "mainBranch": {
          "type": "string",
          "minLength": 1
        },
        "remote": {
          "default": "origin",
          "type": "string",
          "const": "origin"
        },
        "githubTransport": {
          "type": "string",
          "const": "gh"
        },
        "checks": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
              },
              "command": {
                "type": "string",
                "minLength": 1
              },
              "args": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "timeoutMs": {
                "default": 300000,
                "type": "integer",
                "minimum": 100,
                "maximum": 3600000
              },
              "resource": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "command",
              "args",
              "timeoutMs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "schemaVersion",
        "name",
        "repository",
        "mainBranch",
        "remote",
        "githubTransport",
        "checks"
      ],
      "additionalProperties": false
    },
    "assignments": {
      "type": "object",
      "properties": {
        "DEFINE": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "PLAN": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "BUILD": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "VERIFY": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "REVIEW": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "SHIP": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "DEFINE",
        "PLAN",
        "BUILD",
        "VERIFY",
        "REVIEW",
        "SHIP"
      ],
      "additionalProperties": false
    },
    "tasks": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "dependsOn": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
            }
          },
          "acceptance": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "title",
          "description",
          "dependsOn",
          "acceptance"
        ],
        "additionalProperties": false
      }
    },
    "rulesHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "runnerVersion": {
      "type": "string",
      "const": "0.1.0-alpha.1"
    },
    "skillsVersion": {
      "type": "string",
      "const": "0.1.0-alpha.1"
    },
    "permissions": {
      "type": "object",
      "properties": {
        "publishIssues": {
          "type": "boolean"
        },
        "mergeIntermediate": {
          "type": "boolean"
        }
      },
      "required": [
        "publishIssues",
        "mergeIntermediate"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "featureId",
    "title",
    "spec",
    "project",
    "assignments",
    "tasks",
    "rulesHash",
    "runnerVersion",
    "skillsVersion",
    "permissions"
  ],
  "additionalProperties": false
}
