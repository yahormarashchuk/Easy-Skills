{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "featureId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "spec": {
      "type": "string",
      "minLength": 1
    },
    "assignments": {
      "type": "object",
      "properties": {
        "DEFINE": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "PLAN": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "BUILD": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "VERIFY": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "REVIEW": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "SHIP": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "DEFINE",
        "PLAN",
        "BUILD",
        "VERIFY",
        "REVIEW",
        "SHIP"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "publishIssues": {
          "type": "boolean"
        },
        "mergeIntermediate": {
          "type": "boolean"
        }
      },
      "required": [
        "publishIssues",
        "mergeIntermediate"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "featureId",
    "title",
    "spec",
    "assignments",
    "permissions"
  ],
  "additionalProperties": false
}
