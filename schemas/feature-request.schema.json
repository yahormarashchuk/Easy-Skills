{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "featureId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "spec": {
      "type": "string",
      "minLength": 1
    },
    "assignments": {
      "type": "object",
      "properties": {
        "DEFINE": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            },
            "effort": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "PLAN": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            },
            "effort": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "BUILD": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            },
            "effort": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "VERIFY": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            },
            "effort": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "REVIEW": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            },
            "effort": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        },
        "SHIP": {
          "type": "object",
          "properties": {
            "provider": {
              "type": "string",
              "enum": [
                "codex",
                "claude-code"
              ]
            },
            "model": {
              "type": "string",
              "minLength": 1,
              "maxLength": 150,
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:/-]*$"
            },
            "effort": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_-]{0,31}$"
            }
          },
          "required": [
            "provider",
            "model"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "DEFINE",
        "PLAN",
        "BUILD",
        "VERIFY",
        "REVIEW",
        "SHIP"
      ],
      "additionalProperties": false
    },
    "permissions": {
      "type": "object",
      "properties": {
        "publishIssues": {
          "type": "boolean"
        },
        "mergeIntermediate": {
          "type": "boolean"
        }
      },
      "required": [
        "publishIssues",
        "mergeIntermediate"
      ],
      "additionalProperties": false
    },
    "verification": {
      "type": "object",
      "properties": {
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
          }
        },
        "browserTools": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^mcp__[\\w-]+__[\\w-]+$"
          }
        }
      },
      "required": [
        "diagnostics",
        "browserTools"
      ],
      "additionalProperties": false
    },
    "workflow": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "const": "direct"
        },
        "issue": {
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "baseHead": {
          "type": "string",
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "permissions": {
          "type": "object",
          "properties": {
            "pushBranch": {
              "type": "boolean"
            },
            "createPullRequest": {
              "type": "boolean"
            },
            "closeIssueOnMerge": {
              "type": "boolean"
            }
          },
          "required": [
            "pushBranch",
            "createPullRequest",
            "closeIssueOnMerge"
          ],
          "additionalProperties": false
        },
        "context": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^\\.easy-skills\\/(?:rules\\/[^:]+|context\\/[^:]+|project\\.yaml|decisions\\/onboarding\\.json)$"
          },
          "additionalProperties": {
            "type": "string"
          }
        }
      },
      "required": [
        "mode",
        "baseHead",
        "permissions",
        "context"
      ],
      "additionalProperties": false
    },
    "repairPolicy": {
      "default": {
        "maxCompletedAttempts": 3
      },
      "type": "object",
      "properties": {
        "maxCompletedAttempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "maxCompletedAttempts"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "featureId",
    "title",
    "spec",
    "assignments",
    "permissions",
    "repairPolicy"
  ],
  "additionalProperties": false
}
